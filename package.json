{
  "name": "veilarbdetaljerfs",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "vite --mode lokal",
    "dev": "vite --mode lokal",
    "build": "tsc && vite build --base=https://cdn.nav.no/obo/prod/veilarbdetaljerfs/dist",
    "build:dev": "tsc && vite build --base=https://cdn.nav.no/obo/dev/veilarbdetaljerfs/dist",
    "lint": "oxlint src",
    "preview": "vite preview",
    "prettier:check": "prettier --check src --config .prettierrc.json",
    "prettier:write": "prettier --write src --config .prettierrc.json",
    "test": "vitest",
    "build:gh-pages": "tsc && vite build --mode demo --base=/veilarbdetaljerfs/",
    "prepare": "husky"
  },
  "dependencies": {
    "@navikt/aksel-icons": "8.23.0",
    "@navikt/arbeidssokerregisteret-utils": "4.0.0",
    "@navikt/ds-css": "8.23.0",
    "@navikt/ds-react": "8.23.0",
    "constate": "4.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "swr": "2.5.1",
    "vite-plugin-svgr": "5.2.0"
  },
  "devDependencies": {
    "@msw/data": "1.1.9",
    "@navikt/aksel-stylelint": "8.23.0",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "graphql": "17.1.0",
    "husky": "9.1.7",
    "jsdom": "31.0.1",
    "lint-staged": "17.6.1",
    "msw": "3.0.7",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "prettier": "3.10.1",
    "stylelint": "18.1.0",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "lint-staged": {
    "src/**/*.css": [
      "stylelint"
    ],
    "src/**/*.{json,md}": [
      "prettier --write"
    ],
    "src/**/*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "oxlint"
    ]
  },
  "msw": {
    "workerDirectory": "public"
  },
  "stylelint": {
    "extends": "@navikt/aksel-stylelint/recommended"
  }
}
