{
  "name": "veilarbdetaljerfs",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "vite --mode lokal",
    "dev": "vite --mode lokal",
    "build": "tsc && vite build --base=https://cdn.nav.no/obo/prod/veilarbdetaljerfs/dist",
    "build:dev": "tsc && vite build --base=https://cdn.nav.no/obo/dev/veilarbdetaljerfs/dist",
    "lint": "oxlint src",
    "preview": "vite preview",
    "prettier:check": "prettier --check src --config .prettierrc.json",
    "prettier:write": "prettier --write src --config .prettierrc.json",
    "test": "vitest",
    "build:gh-pages": "tsc && vite build --mode demo --base=/veilarbdetaljerfs/",
    "prepare": "husky"
  },
  "dependencies": {
    "@navikt/aksel-icons": "8.19.1",
    "@navikt/arbeidssokerregisteret-utils": "2.1.0",
    "@navikt/ds-css": "8.19.1",
    "@navikt/ds-react": "8.19.1",
    "constate": "4.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "swr": "2.5.1",
    "vite-plugin-svgr": "5.2.0"
  },
  "devDependencies": {
    "@mswjs/data": "0.16.2",
    "@mswjs/storage": "0.1.0",
    "@navikt/aksel-stylelint": "8.19.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "husky": "9.1.7",
    "jsdom": "30.1.2",
    "lint-staged": "17.6.0",
    "msw": "2.15.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2004",
    "prettier": "3.9.10",
    "stylelint": "17.16.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  },
  "lint-staged": {
    "src/**/*.css": [
      "stylelint"
    ],
    "src/**/*.{json,md}": [
      "prettier --write"
    ],
    "src/**/*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "oxlint"
    ]
  },
  "msw": {
    "workerDirectory": "public"
  },
  "stylelint": {
    "extends": "@navikt/aksel-stylelint/recommended"
  }
}
